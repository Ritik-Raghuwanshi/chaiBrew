{
  "name": "chaibrew",
  "version": "1.0.2",
  "description": "A lightweight utility-first CSS engine. Brew your Chai in your own style.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
