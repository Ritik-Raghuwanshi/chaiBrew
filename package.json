  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ritik-Raghuwanshi/chaiBrew.git"
  },
  "bugs": {
    "url": "https://github.com/Ritik-Raghuwanshi/chaiBrew/issues"
  },
  "homepage": "https://github.com/Ritik-Raghuwanshi/chaiBrew#readme",
  "devDependencies": {
    "esbuild": "^0.21.0"
  }
}
